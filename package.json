{
  "name": "lanebreak",
  "version": "0.2.0",
  "private": true,
  "description": "Real-time lane card battler: deterministic shared simulation, browser client, AI opponent.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "test": "tsx --test --test-timeout=120000 test/*.test.ts",
    "sim": "tsx scripts/batch.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "@types/ws": "^8.5.12"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "esbuild": "^0.28.2"
  }
}
